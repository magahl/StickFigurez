@using System.Globalization

<svg class="cleaner-svg"
     width="@Width"
     height="@Size"
     viewBox="0 0 20 24"
     overflow="visible"
     style="--cleaner-duration: @CycleDuration;"
     xmlns="http://www.w3.org/2000/svg"
     stroke="currentColor"
     stroke-linecap="round"
     stroke-linejoin="round"
     fill="none">

    <g class="cleaner-rig">
     <g transform="translate(-12, 0)">

        @* Wheelie bin — tilted, top toward figure, wheel at far side *@
        <g class="cleaner-bin">
            @* Bin body outline (tilted parallelogram) *@
            <path d="M 24 10.5 L 19 8.5 L 15 20.5 L 20 22.5 Z" stroke-width="1.6"/>
            @* Lid — slight overhang past bin top *@
            <line x1="18.5" y1="7.9" x2="24.6" y2="10.35" stroke-width="1.4"/>
            <line x1="18.5" y1="7.9" x2="19" y2="8.5" stroke-width="1.2"/>
            <line x1="24.6" y1="10.35" x2="24" y2="10.5" stroke-width="1.2"/>
            @* Handle grip protruding toward figure *@
            <line x1="24" y1="10.5" x2="25" y2="11" stroke-width="1.4"/>
            @* Wheel — at bottom-near corner *@
            <g class="cleaner-wheel">
                <circle cx="20" cy="22" r="1.8" stroke-width="1.2"/>
                <line x1="20" y1="20.2" x2="20" y2="23.8" stroke-width="0.6"/>
                <line x1="18.2" y1="22" x2="21.8" y2="22" stroke-width="0.6"/>
            </g>
        </g>

        @* Figure *@
        @* Head — sits on body neck *@
        @* Proportions: r=2 and cy=6 — bent-over pose pushing bin; figure offset by outer translate(-12,0). *@
        <circle cx="27" cy="6" r="2" fill="currentColor" stroke="none"/>

        @* Body — slight forward lean, top meets head bottom *@
        <line x1="26" y1="16" x2="27" y2="8" stroke-width="1.6"/>

        @* Front arm — Runner-style: upper pivots at shoulder, forearm at elbow *@
        <g class="cleaner-arm-front">
            <line x1="0" y1="0" x2="0" y2="3.5" stroke-width="1.6"/>
            <g class="cleaner-forearm-front">
                <line x1="0" y1="0" x2="0" y2="3.5" stroke-width="1.6"/>
            </g>
        </g>

        @* Back arm — gripping handle *@
        <line x1="27" y1="8" x2="24" y2="10.5" stroke-width="1.6"/>

        @* Legs — Runner-style: vertical unit lines positioned via translate+rotate.
           Both legs hip at (26, 16); symmetric ±25° absolute swing from vertical. *@
        <g class="cleaner-leg-l">
            <line x1="0" y1="0" x2="0" y2="3" stroke-width="1.6"/>
            <g class="cleaner-shin-l">
                <line x1="0" y1="0" x2="0" y2="3" stroke-width="1.6"/>
                <line x1="0" y1="3" x2="1.2" y2="3" stroke-width="1.5"/>
            </g>
        </g>
        <g class="cleaner-leg-r">
            <line x1="0" y1="0" x2="0" y2="3" stroke-width="1.6"/>
            <g class="cleaner-shin-r">
                <line x1="0" y1="0" x2="0" y2="3" stroke-width="1.6"/>
                <line x1="0" y1="3" x2="1.2" y2="3" stroke-width="1.5"/>
            </g>
        </g>

     </g>
    </g>

</svg>

@code {
    [Parameter] public int Size { get; set; } = 24;
    [Parameter] public int Speed { get; set; } = 5;

    private int ClampedSpeed => Math.Clamp(Speed, 1, 10);

    private string CycleDuration =>
        $"{(2.2 - (ClampedSpeed - 1) * 0.18).ToString("F2", CultureInfo.InvariantCulture)}s";

    private int Width => (int)(Size * 20.0 / 24.0);
}
