@using System.Globalization

@* Printer (left, simplified silhouette) + stickman (right) picking output sheets
   off the tray. Figure faces left toward the machine.
   Proportions: head r=2.5 cy=4.5, torso 6.5 (7→13.5), legs 7.5 (13.5→21). *@
<svg class="printer-svg"
     width="@Width" height="@Size"
     viewBox="0 0 26 24"
     style="--printer-duration: @CycleDuration;"
     xmlns="http://www.w3.org/2000/svg"
     stroke="currentColor"
     stroke-linecap="round"
     fill="none">

    @* Top assembly — chunky feeder block on the left (x=2–5.5, y=4–8) plus a
       thin lid hinged at the feeder and tilted gently upward to a pointed tip
       at (10.8, 4.95). Lid edges run parallel: top (5.5, 5.5)→(9.5, 4.3);
       bottom (5.5, 6.8)→(9.5, 5.6). *@
    <path fill="currentColor" stroke="none"
          d="M 2 4 H 5.5 V 5.5 L 9.5 4.3 L 10.8 4.95 L 9.5 5.6 L 5.5 6.8 V 8 H 2 Z"/>

    @* Main body silhouette — output-tray ledge bumping right at y=11.2–13.
       evenodd carves the drawer slits out of the fill. *@
    <path fill-rule="evenodd" fill="currentColor" stroke="none"
          d="M 2 8.5 H 11 V 11.2 H 14.5 V 13 H 11 V 20 H 2 Z
             M 3.2 14.8 H 9.8 V 15.3 H 3.2 Z
             M 3.2 16.4 H 9.8 V 16.9 H 3.2 Z
             M 3.2 18.0 H 9.8 V 18.5 H 3.2 Z"/>

    @* Output sheet — long sheet emerging from the tray slot toward the figure. *@
    <rect x="10.7" y="11.7" width="5" height="1" fill="currentColor" stroke="none"/>

    @* Castor wheels under base. *@
    <circle cx="3.2" cy="20.8" r="0.85" fill="currentColor" stroke="none"/>
    <circle cx="9.8" cy="20.8" r="0.85" fill="currentColor" stroke="none"/>

    @* Stickman *@
    <circle cx="20" cy="4.5" r="2.5" fill="currentColor" stroke="none"/>
    <line x1="20" y1="7" x2="20" y2="13.5" stroke-width="2"/>
    <line x1="20" y1="13.5" x2="18.2" y2="21" stroke-width="2"/>
    <line x1="20" y1="13.5" x2="21.8" y2="21" stroke-width="2"/>

    @* Far-side arm — hangs at figure's right (viewer's right). *@
    <line x1="20" y1="8" x2="21.6" y2="11.6" stroke-width="2"/>
    <line x1="21.6" y1="11.6" x2="21.9" y2="13.8" stroke-width="2"/>

    @* Near-side arm. Upper arm static at -50° from straight-down so it points
       at the output tray; elbow lands at (17.32, 10.25). Forearm pivots at the
       elbow, animated between extended (reaching the tray) and folded (lifted). *@
    <line x1="20" y1="8" x2="17.32" y2="10.25" stroke-width="2"/>
    <g class="printer-forearm">
        <line x1="0" y1="0" x2="0" y2="3.5" stroke-width="2"/>
    </g>

    @* Picked-up sheet. Translated to track the hand; opacity keyed so it only
       appears once the hand reaches the tray, vanishes again after the lift. *@
    <rect class="printer-held-paper"
          x="-6.5" y="-0.4" width="5.5" height="0.8"
          fill="currentColor" stroke="none"/>

</svg>

@code {
    [Parameter] public int Size { get; set; } = 24;
    [Parameter] public int Speed { get; set; } = 5;

    private int Clamped => Math.Clamp(Speed, 1, 10);

    private string CycleDuration =>
        $"{(2.6 - (Clamped - 1) * 0.18).ToString("F2", CultureInfo.InvariantCulture)}s";

    private int Width => (int)(Size * 26.0 / 24.0);
}
