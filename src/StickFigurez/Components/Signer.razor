@using System.Globalization

@* Front view. Head r=2.5 cy=6. Torso 7.5 (8.5→16). Legs 6 (16→22). No feet.
   viewBox 24×26 — extra width/height keeps the raised disc inside the frame. *@
<svg class="signer-svg"
     width="@Width"
     height="@Size"
     viewBox="0 0 24 26"
     style="--sign-duration: @CycleDuration;"
     xmlns="http://www.w3.org/2000/svg"
     stroke="currentColor"
     stroke-linecap="round"
     fill="none">

    @* Head *@
    <circle cx="6" cy="6" r="2.5" fill="currentColor" stroke="none"/>

    @* Torso *@
    <line x1="6" y1="8.5" x2="6" y2="16" stroke-width="2"/>

    @* Legs *@
    <line x1="6" y1="16" x2="3.5" y2="22" stroke-width="2"/>
    <line x1="6" y1="16" x2="8.5" y2="22" stroke-width="2"/>

    @* Off-arm — figure's right (viewer's left), hangs at side *@
    <line x1="6" y1="9.5" x2="4" y2="13" stroke-width="2"/>
    <line x1="4" y1="13" x2="3.5" y2="15.5" stroke-width="2"/>

    @* Sign-side: arm + sign rotate together around shoulder so the arm
       follows the sign as it rises. Sign group counter-rotates to stay upright. *@
    <g class="arm-sign">
        @* Two-segment arm: shoulder → elbow → hand *@
        <line x1="6" y1="9.5" x2="8" y2="11.5" stroke-width="2"/>
        <line x1="8" y1="11.5" x2="10.5" y2="12" stroke-width="2"/>

        @* Sign — flips front-to-back around the hand pivot *@
        <g class="sign">
            @* Handle: from hand to disc edge (stops outside the disc) *@
            <line x1="10.5" y1="12" x2="12.36" y2="10.65" stroke-width="1.4"/>
            <circle cx="16" cy="8" r="4.5" stroke-width="1.2" fill="none"/>
            <text x="16" y="9.3" text-anchor="middle"
                  textLength="7" lengthAdjust="spacingAndGlyphs"
                  font-size="3.6" font-weight="bold" font-family="sans-serif"
                  fill="currentColor" stroke="none">@Text</text>
        </g>
    </g>

</svg>

@code {
    [Parameter] public int Size { get; set; } = 32;
    [Parameter] public int Speed { get; set; } = 5;
    [Parameter] public string Text { get; set; } = "STOP";

    private int Clamped => Math.Clamp(Speed, 1, 10);

    private string CycleDuration =>
        $"{(2.4 - (Clamped - 1) * 0.18).ToString("F2", CultureInfo.InvariantCulture)}s";

    private int Width => (int)(Size * 24.0 / 26.0);
}
