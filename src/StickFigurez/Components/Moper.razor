@using System.Globalization
  
<svg class="moper-svg"
     width="@Width"
     height="@Size"
     viewBox="0 0 18 25"
     style="--mope-duration: @CycleDuration;"
     xmlns="http://www.w3.org/2000/svg"
     stroke="currentColor"
     stroke-linecap="round"
     fill="none">

    <g class="moper-body">

        @* Head — heavily drooped forward and down *@
        @* Proportions: r=2.3 and cy=6 — hunched-over sad pose, head drooped past spec; spine is curved Q-path not straight torso. *@
        <circle cx="12" cy="6" r="2.3" fill="currentColor" stroke="none"/>

        @* Hunched back — strong forward curve from hip to shoulder *@
        <path d="M 5 14 Q 6 10 10 7.5" stroke-width="1.6"/>

        @* Arms — dangling from shoulder, gentle sway *@
        <g class="moper-arms">
            <line x1="10" y1="7.5" x2="9" y2="14" stroke-width="1.6"/>
            <line x1="10" y1="7.5" x2="11.5" y2="14" stroke-width="1.6"/>
        </g>

        @* Legs — straight at rest, knee bends only during swing *@
        <g class="moper-leg-l">
            <line x1="5" y1="14" x2="4.5" y2="18.7" stroke-width="1.6"/>
            <g class="moper-shin-l">
                <line x1="4.5" y1="18.7" x2="4" y2="23.4" stroke-width="1.6"/>
                <line x1="4" y1="23.4" x2="5.5" y2="23.4" stroke-width="1.5"/>
            </g>
        </g>
        <g class="moper-leg-r">
            <line x1="5" y1="14" x2="5.5" y2="18.7" stroke-width="1.6"/>
            <g class="moper-shin-r">
                <line x1="5.5" y1="18.7" x2="6" y2="23.4" stroke-width="1.6"/>
                <line x1="6" y1="23.4" x2="7.5" y2="23.4" stroke-width="1.5"/>
            </g>
        </g>

        @* Tear forming, falling — pointed top, round bottom *@
        <path class="moper-tear"
              d="M 13 7.4 Q 13.55 8.05 13.55 8.6 A 0.55 0.55 0 1 1 12.45 8.6 Q 12.45 8.05 13 7.4 Z"
              fill="currentColor" stroke="none"/>

    </g>

</svg>

@code {
    [Parameter] public int Size { get; set; } = 24;
    [Parameter] public int Speed { get; set; } = 5;

    private int ClampedSpeed => Math.Clamp(Speed, 1, 10);

    private string CycleDuration =>
        $"{(4.0 - (ClampedSpeed - 1) * 0.25).ToString("F2", CultureInfo.InvariantCulture)}s";

    private int Width => (int)(Size * 18.0 / 24.0);
}
